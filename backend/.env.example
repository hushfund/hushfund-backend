# Ethereum Mainnet only. Reads ../config/mainnet.json and ../deployments/mainnet.json.
NETWORK=mainnet
# Ethereum JSON-RPC for that network (Alchemy, Infura, QuickNode...). Needs eth_getLogs.
RPC_URL=
# Local standalone default only. Managed hosting services supply their own PORT.
PORT=3007
# Comma-separated list of frontend origins allowed to call this API. Production: https://hushfund.app
CORS_ORIGINS=
# Set to 1 when running behind a reverse proxy
TRUST_PROXY=1
# The default hosted setup serves the web and API separately.
SERVE_FRONTEND=false

# ---------- Relayer (submits withdrawals/borrows so the user's wallet never appears) ----------
# Hot wallet private key. Fund it with ETH for gas; it earns the relayer fee in USDC. Leave empty to disable.
RELAYER_PRIVATE_KEY=
# Gas budget per action. Validate estimates before enabling the relayer.
RELAYER_GAS_WITHDRAW=3500000
RELAYER_GAS_BORROW=3500000
# Margin over gas cost in basis points (2000 = +20%) and minimum fee in USDC
RELAYER_MARGIN_BPS=2000
RELAYER_MIN_FEE_USDC=1
# Refuse to relay below this ETH balance
RELAYER_MIN_BALANCE_ETH=0
# DATABASE_URL is provided by the platform; required for persistent relayer state.
# ETH price used only when config has no Chainlink feed.
ETH_USD_FALLBACK=3000

# ---------- Developer-paid gas (the relayer wallet's ETH pays for users) ----------
# true: the relayer also submits deposits and repayments, so users need no ETH
SPONSOR_DEPOSITS=true
# true: withdraw/borrow relayer fee is 0 USDC (developer pays that gas too)
SPONSOR_FEES=true
RELAYER_GAS_DEPOSIT=1600000
RELAYER_GAS_REPAY=4500000
# Most ETH the relayer may spend on sponsored transactions per UTC day (0 = no cap)
SPONSOR_DAILY_BUDGET_ETH=0.5
# Sponsored transactions allowed per wallet per UTC day
SPONSOR_PER_ADDRESS_DAILY=3

# ---------- Openfort (embedded wallets) ----------
OPENFORT_SECRET_KEY=
OPENFORT_SHIELD_PUBLISHABLE_KEY=
OPENFORT_SHIELD_SECRET_KEY=
OPENFORT_SHIELD_ENCRYPTION_SHARE=

# ---------- Deploy (used by scripts/deploy.sh) ----------
# Verifies contracts on Etherscan after deploy (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=
# Foundry keystore account used to deploy (cast wallet import hushfund-deployer --interactive)
DEPLOYER_ACCOUNT=hushfund-deployer
# Alternative to the encrypted Foundry account, for an explicitly authorized deploy only.
# Use your hosting secret manager; never paste a private key into this template.
DEPLOYER_PRIVATE_KEY=

# Persistent state: configure a private PostgreSQL connection using your secret manager.
DATABASE_URL=
# Public browser settings served by GET /api/public-env (never server secrets).
VITE_NETWORK=mainnet
VITE_API_URL=
VITE_RPC_URL=
VITE_MAINNET_RPC_URL=
VITE_OPENFORT_PUBLISHABLE_KEY=
VITE_OPENFORT_SHIELD_PUBLISHABLE_KEY=
VITE_CREATE_ENCRYPTED_SESSION_ENDPOINT=/api/protected-create-encryption-session
VITE_WALLET_CONNECT_PROJECT_ID=
VITE_DOCS_URL=https://hushfund.app/docs
VITE_GUIDE_URL=https://hushfund.app/docs?guide=1
VITE_X_URL=https://x.com/Hushfund_
